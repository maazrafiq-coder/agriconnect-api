# ─── APPLICATION ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:5173

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Local PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/agriconnect?schema=public"

# Production (Supabase example)
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Both secrets MUST be at least 32 characters — the app refuses to boot
# otherwise (see src/config/env.validation.ts). Generate real ones with:
#   openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=15m
# JWT_REFRESH_SECRET is no longer used (refresh tokens are opaque, stored hashed). Optional.
JWT_REFRESH_EXPIRES_IN=7d

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
# Set to true in development to skip real SMS and return OTP in response.
# DANGER: '000000' then verifies for EVERY account. In production the app
# refuses to boot with this on, unless you ALSO set ALLOW_INSECURE_DEV_OTP=true
# (a deliberate, logged override for UAT while no SMS provider is wired up).
OTP_DEV_MODE=true
# ALLOW_INSECURE_DEV_OTP=false

# Swagger /docs: always on outside production. In production it is OFF unless
# ENABLE_SWAGGER=true, and then SWAGGER_USER / SWAGGER_PASSWORD are required.
# ENABLE_SWAGGER=false
# SWAGGER_USER=
# SWAGGER_PASSWORD=

# Twilio (production SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ─── FILE STORAGE ─────────────────────────────────────────────────────────────
# As of Round 2, Milestone 4, this is REQUIRED in production — every upload
# (KYC docs, listing photos, clarification attachments) goes to this bucket.
# Local disk is never used anymore (Railway's container filesystem is
# ephemeral and was silently losing every file on redeploy).
#
# UPLOAD_DEST / MAX_FILE_SIZE_MB below are legacy and no longer read by any
# upload path — kept only so old .env files don't fail validation.
UPLOAD_DEST=./uploads
MAX_FILE_SIZE_MB=10

# Railway Storage Buckets (S3-compatible) — get these from your bucket's
# connection details in the Railway dashboard.
AWS_ACCESS_KEY_ID=your_railway_bucket_access_key
AWS_SECRET_ACCESS_KEY=your_railway_bucket_secret
AWS_REGION=auto
AWS_S3_BUCKET=agriconnect-uploads
# Railway's S3-compatible endpoint for this bucket — required for Railway
# Storage Buckets. Leave unset entirely to talk to real AWS S3 instead
# (e.g. if migrating off Railway later — same code either way).
AWS_S3_ENDPOINT=https://your-bucket-name.storage.railway.app

# ─── REDIS (optional caching) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── EMAIL ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@agriconnect.pk
SMTP_PASS=your_smtp_password
EMAIL_FROM="AgriConnect PK <noreply@agriconnect.pk>"

# ─── GOOGLE MAPS ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_key

# ─── PAYMENTS ─────────────────────────────────────────────────────────────────
EASYPAISA_MERCHANT_ID=your_merchant_id
EASYPAISA_API_KEY=your_api_key
JAZZCASH_MERCHANT_ID=your_merchant_id
JAZZCASH_PASSWORD=your_password
JAZZCASH_INTEGRITY_SALT=your_salt
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── OPERATIONS (Round 3 M9) ─────────────────────────────────────────────────
# Railway/nginx in front of the app? Set the number of proxy hops (Railway = 1)
# so rate limits are per real client IP. Unset = trust nothing (direct exposure).
# TRUST_PROXY=1
# LOG_LEVEL=log            # error | warn | log | debug | verbose
# LOG_FORMAT=json          # json (default in production) | pretty (default elsewhere)
# Error reporting: OFF unless SENTRY_DSN is set AND `npm i @sentry/node` was run.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
