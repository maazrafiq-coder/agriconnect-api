# ─── APPLICATION ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:5173

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Local PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/agriconnect?schema=public"

# Production (Supabase example)
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Both secrets MUST be at least 32 characters — the app refuses to boot
# otherwise (see src/config/env.validation.ts). Generate real ones with:
#   openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_also_min_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
# Set to true in development to skip real SMS and return OTP in response
OTP_DEV_MODE=true

# Twilio (production SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ─── FILE STORAGE ─────────────────────────────────────────────────────────────
# Local uploads (development)
UPLOAD_DEST=./uploads
MAX_FILE_SIZE_MB=10

# AWS S3 (production)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=ap-south-1
AWS_S3_BUCKET=agriconnect-uploads
AWS_CLOUDFRONT_URL=https://cdn.agriconnect.pk

# ─── REDIS (optional caching) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── EMAIL ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@agriconnect.pk
SMTP_PASS=your_smtp_password
EMAIL_FROM="AgriConnect PK <noreply@agriconnect.pk>"

# ─── GOOGLE MAPS ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_key

# ─── PAYMENTS ─────────────────────────────────────────────────────────────────
EASYPAISA_MERCHANT_ID=your_merchant_id
EASYPAISA_API_KEY=your_api_key
JAZZCASH_MERCHANT_ID=your_merchant_id
JAZZCASH_PASSWORD=your_password
JAZZCASH_INTEGRITY_SALT=your_salt
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
