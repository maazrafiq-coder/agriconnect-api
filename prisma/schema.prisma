// prisma/schema.prisma
// AgriConnect Pakistan — Full Database Schema (v2 — relation-consistent)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  FARMER
  TRADER
  MILLER
  EXPORTER
  BUYER
  TRANSPORTER
  WAREHOUSE
  TESTING_AGENCY
  BANK
  INSURANCE
  INVESTOR
  ADMIN
  MODERATOR  // delegated staff: can review KYC/documents and recommend
             // approval, but only ADMIN can grant final approval
}

enum KycStatus {
  PENDING         // just registered, nothing submitted yet
  SUBMITTED       // registration/docs submitted, awaiting any review
  RECOMMENDED     // a moderator reviewed it and recommends approval —
                  // still requires ADMIN to actually approve
  INFO_REQUESTED  // admin needs more from the user before deciding —
                  // see User.kycInfoRequestNote
  APPROVED        // can log in
  REJECTED
}

// NOTE: ProductCategory used to be a hardcoded enum here. It's now the
// Category model below — a real table the admin can add/edit/deactivate
// from the Admin Portal without a code deploy. Product.category stores
// the Category.slug as a plain string (see Product model).

model Category {
  id          String   @id @default(uuid())
  name        String   @unique          // e.g. "Pulses"
  slug        String   @unique          // e.g. "pulses" — what Product.category stores
  icon        String?                    // e.g. "🫘" — shown in filters/dropdowns
  description String?
  isActive    Boolean  @default(true)   // soft "remove" — hides from filters/create-listing
                                          // without breaking existing products that reference it
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units       Unit[]

  @@map("categories")
}

model City {
  id        String   @id @default(uuid())
  name      String                        // e.g. "Sheikhupura"
  province  String                        // e.g. "Punjab" — free text, matches the province
                                            // dropdown already used by Product.locationProvince
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, province])              // "Multan, Punjab" is distinct from a hypothetical
                                            // "Multan" in another province — same name shouldn't
                                            // collide across provinces
  @@map("cities")
}

model Unit {
  id         String    @id @default(uuid())
  name       String                        // e.g. "40kg bags", "Maunds", "Bales"
  categoryId String?                       // null = applies to ALL categories (e.g. "kg", "tons")
                                            // set   = only offered for that specific category
                                            // (e.g. "Bales" only makes sense for Cotton)
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([name, categoryId])
  @@map("units")
}

enum RiceStage {
  PADDY
  BROWN_RICE
  MILLED_WHITE
  WHITE_RICE
  PARBOILED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW  // submitted, awaiting admin approval before going live
  ACTIVE
  REJECTED        // admin declined it — see Product.rejectionNote. Editing
                   // a rejected listing moves it back to PENDING_REVIEW.
  UNDER_OFFER
  SOLD
  PAUSED
  REMOVED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
  WITHDRAWN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
  FAILED
}

enum TransactionType {
  ORDER_PAYMENT
  STORAGE_FEE
  TESTING_FEE
  TRANSPORT_FEE
  INSURANCE_PREMIUM
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  PLATFORM_FEE
  REFUND
}

enum WarehouseType {
  COLD_STORAGE
  DRY_STORAGE
  CONTROLLED_ATMOSPHERE
  BONDED
}

enum ReceiptStatus {
  ACTIVE
  UNDER_LIEN
  RELEASED
  EXPIRED
}

// Round 2 Milestone 2: real warehouse booking lifecycle. Previously
// StorageBooking.status was a free-text string that only ever held
// "confirmed" or "active" — no operator accept/reject step existed at
// all, meaning a buyer's booking request was instantly treated as
// confirmed with no warehouse involvement. See StorageBooking.status.
enum BookingStatus {
  REQUESTED  // buyer submitted a booking request; warehouse has not acted on it yet
  ACCEPTED   // warehouse operator accepted — buyer should now deliver goods
  REJECTED   // warehouse operator declined the request (see StorageBooking.rejectionReason)
  ACTIVE     // goods have arrived and a Digital Warehouse Receipt was issued
  COMPLETED  // goods have been released / booking lifecycle finished
  CANCELLED  // withdrawn by depositor or operator before goods arrived
}

enum LienStatus {
  ACTIVE
  RELEASED
  DEFAULTED
}

// NEW_Changes item 10 — invoicing/GRN/gate-pass paperwork for a storage
// booking. Manual payment confirmation only: AgriConnect has no payment
// gateway integrated anywhere (see StorageBooking/Order — all payments
// are internal ledger entries), so "payment confirmation" here means the
// operator/admin marking an invoice paid after receiving payment
// out-of-band (bank transfer, cash, etc.), with an optional reference note.
enum InvoiceStatus {
  UNPAID
  PAID
}

// A Gate Out Pass authorizes goods to physically leave the warehouse.
// Requested by the operator, then approved either by the depositor (the
// goods' owner) or an admin/moderator — see GateOutPass.approverRole.
enum GatePassStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TestingStatus {
  REQUESTED
  ASSIGNED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransportStatus {
  REQUESTED
  QUOTED
  BOOKED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum VehicleType {
  SMALL_TRUCK
  MEDIUM_TRUCK
  LARGE_TRUCK
  CONTAINER
  BULK_CARGO
  REFRIGERATED
}

enum NotificationType {
  ORDER_UPDATE
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  PAYMENT_RECEIVED
  PAYMENT_DUE
  TESTING_UPDATE
  TRANSPORT_UPDATE
  WAREHOUSE_UPDATE
  KYC_UPDATE
  LOAN_UPDATE
  SYSTEM
}

// Round 2 Milestone 3: a real two-way clarification workflow. Previously
// "request more info" on KYC was a single free-text note
// (User.kycInfoRequestNote) with no way for the user to reply, no
// attachments, and no history if it happened more than once. This model
// is deliberately generic — `subjectType`/`subjectId` instead of a hard
// FK to User — so the exact same request/respond/resolve flow, file
// attachments, and admin UI can be reused for warehouse/testing-agency/
// transport provider review in a later milestone without a second
// purpose-built table per subject type. USER_KYC is the only subjectType
// wired up so far.
enum ClarificationStatus {
  OPEN        // admin asked, waiting on the subject's response
  RESPONDED   // subject responded, awaiting the reviewer's next look
  RESOLVED    // reviewer marked it resolved (used to help decide approve/reject)
}

model ReviewClarification {
  id              String   @id @default(uuid())
  subjectType     String   // "USER_KYC" today; reserved: "WAREHOUSE_PROFILE" | "TESTING_AGENCY_PROFILE" | "TRANSPORT_PROFILE"
  subjectId       String   // id of the row identified by subjectType (e.g. User.id for USER_KYC)
  requestedById   String   // admin/moderator who asked
  requestMessage  String
  status          ClarificationStatus @default(OPEN)
  responseMessage String?
  respondedAt     DateTime?
  resolvedById    String?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attachments     ClarificationAttachment[]

  @@index([subjectType, subjectId])
  @@index([status])
  @@map("review_clarifications")
}

model ClarificationAttachment {
  id              String   @id @default(uuid())
  clarificationId String
  uploadedById    String   // whoever attached it — the subject when responding, or a reviewer
  fileName        String   // original filename, for display
  s3Key           String   // server-generated on-disk filename — never user input
  createdAt       DateTime @default(now())

  clarification   ReviewClarification @relation(fields: [clarificationId], references: [id], onDelete: Cascade)

  @@index([clarificationId])
  @@map("clarification_attachments")
}

// ─── USER & IDENTITY ──────────────────────────────────────────────────────────
// Rule: User owns identity only. All domain back-relations live on
// the respective profile model, not on User.

model User {
  id               String    @id @default(uuid())
  // Human-readable, unique, immutable ID (formatted as "AGC-000001" — see
  // formatAgriConnectId()). Backed by a native Postgres sequence via
  // @default(autoincrement()), so it's assigned atomically at creation
  // with no risk of collisions or gaps under concurrent registrations.
  agriConnectSeq   Int       @unique @default(autoincrement())
  phoneNumber      String?   @unique  // optional — user must provide phone OR email (enforced in service layer)
  email            String?   @unique
  passwordHash     String
  role             UserRole
  isActive         Boolean   @default(true)
  isPhoneVerified  Boolean   @default(false)
  isEmailVerified  Boolean   @default(false)
  kycStatus        KycStatus @default(PENDING)
  kycApprovedAt    DateTime?
  kycRejectedAt    DateTime?
  kycRejectionNote String?
  // Set when an admin uses "Request Additional Information" instead of a
  // straight approve/reject. This pair is a denormalized cache of the
  // *latest* request for cheap display in list views (admin user list,
  // the user's own account page) without an extra join — the full
  // two-way thread (every request, the user's response, attachments,
  // resolution) lives in ReviewClarification (subjectType: "USER_KYC",
  // subjectId: this User's id), which is the actual source of truth.
  kycInfoRequestNote String?
  kycInfoRequestedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ── Identity sub-records ──────────────────────────────────────────────────
  profile         UserProfile?
  kycDocuments    KycDocument[]
  otps            Otp[]
  refreshTokens   RefreshToken[]

  // ── Domain profiles (one per role) ───────────────────────────────────────
  // Plural — an operator account can now own more than one warehouse (see
  // WarehouseProfile.userId comment).
  warehouseProfiles    WarehouseProfile[]
  testingAgencyProfile TestingAgencyProfile?
  transportProfile     TransportProfile?

  // ── Marketplace relations (User as seller / buyer / depositor) ────────────
  productsAsSeller  Product[]        @relation("SellerProducts")
  offersAsBuyer     Offer[]          @relation("BuyerOffers")
  ordersAsSeller    Order[]          @relation("SellerOrders")
  ordersAsBuyer     Order[]          @relation("BuyerOrders")

  // ── Storage relations (User as depositor / owner) ─────────────────────────
  storageBookings   StorageBooking[]
  warehouseReceipts WarehouseReceipt[]
  warehouseInvoices WarehouseInvoice[]
  goodsReceiptNotes GoodsReceiptNote[]
  gateOutPasses     GateOutPass[]
  bookingMessages   BookingMessage[]

  // ── Testing / transport as requester ─────────────────────────────────────
  testingRequests   TestingRequest[]  @relation("TestingRequester")
  transportRequests TransportRequest[] @relation("TransportRequester")

  // ── Messaging & social ───────────────────────────────────────────────────
  messagesSent      Message[]         @relation("MessageSender")
  messagesReceived  Message[]         @relation("MessageReceiver")
  ratingsGiven      Rating[]          @relation("RatingReviewer")
  ratingsReceived   Rating[]          @relation("RatingReviewed")
  notifications     Notification[]
  transactions      Transaction[]

  @@index([phoneNumber])
  @@index([email])
  @@index([role])
  @@map("users")
}

model UserProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  fullName        String
  cnicNumber      String?   @unique
  dateOfBirth     DateTime?
  address         String?
  city            String?
  province        String?
  country         String    @default("Pakistan")
  profilePhotoUrl String?
  // Business
  businessName    String?
  ntnNumber       String?
  companyAddress  String?
  licenseNumber   String?
  // Farm (farmers)
  farmSizeAcres   Float?
  farmLocation    String?
  farmGps         String?
  cropsGrown      String[]
  // Bank
  bankName        String?
  bankAccountNo   String?
  iban            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model KycDocument {
  id          String    @id @default(uuid())
  userId      String
  docType     String    // cnic_front | cnic_back | selfie | business_license | ntn
  fileUrl     String
  s3Key       String?
  ocrData     Json?
  status      String    @default("pending")
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kyc_documents")
}

model Otp {
  id        String   @id @default(uuid())
  userId    String
  code      String
  purpose   String   // phone_verify | login | password_reset
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otps")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── PRODUCTS ─────────────────────────────────────────────────────────────────

model Product {
  id               String          @id @default(uuid())
  sellerId         String
  category         String          // Category.slug — see Category model
  name             String
  description      String?
  quantity         Float
  unit             String
  askingPrice      Decimal         @db.Decimal(14, 2)
  currency         String          @default("PKR")
  minOrderQty      Float
  locationCity     String
  locationProvince String
  locationGps      String?
  harvestDate      DateTime?
  packagingType    String?
  deliveryTerms    String?
  status           ProductStatus   @default(DRAFT)
  rejectionNote    String?         // set by admin when status = REJECTED
  viewCount        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  seller           User            @relation("SellerProducts", fields: [sellerId], references: [id])
  riceDetails      RiceProductDetail?
  media            ProductMedia[]
  certDocuments    ProductDocument[]
  offers           Offer[]
  savedBy          SavedProduct[]
  ratings          Rating[]

  @@index([sellerId])
  @@index([category])
  @@index([status])
  @@index([locationProvince])
  @@map("products")
}

model RiceProductDetail {
  id               String    @id @default(uuid())
  productId        String    @unique
  stage            RiceStage
  variety          String
  newCrop          Boolean   @default(true)
  moisturePct      Float?
  grainLengthMm    Float?
  grainWidthMm     Float?
  lWRatio          Float?
  brokenPct        Float?
  chalkinessPct    Float?
  purityPct        Float?
  foreignMatterPct Float?
  damagedGrainPct  Float?
  yellowGrainPct   Float?
  millingYieldPct  Float?
  whitenessIndex   Float?
  color            String?

  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("rice_product_details")
}

model ProductMedia {
  id        String   @id @default(uuid())
  productId String
  type      String   // image | video | document
  url       String
  s3Key     String?
  label     String?
  isPrimary Boolean  @default(false) // the one shown on the listing card face —
                                       // exactly one per product should be true
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model ProductDocument {
  id          String    @id @default(uuid())
  productId   String
  docType     String    // lab_report | certificate | inspection | government | export
  title       String
  fileUrl     String
  s3Key       String?
  issuedBy    String?
  issuedDate  DateTime?
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_documents")
}

model SavedProduct {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("saved_products")
}

// ─── OFFERS & ORDERS ──────────────────────────────────────────────────────────

model Offer {
  id             String      @id @default(uuid())
  productId      String
  buyerId        String
  offeredPrice   Decimal     @db.Decimal(14, 2)
  quantity       Float
  message        String?
  status         OfferStatus @default(PENDING)
  counterPrice   Decimal?    @db.Decimal(14, 2)
  counterMessage String?
  rejectionReason String?
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  product        Product     @relation(fields: [productId], references: [id])
  buyer          User        @relation("BuyerOffers", fields: [buyerId], references: [id])
  order          Order?

  @@index([productId])
  @@index([buyerId])
  @@index([status])
  @@map("offers")
}

model Order {
  id              String        @id @default(uuid())
  offerId         String        @unique
  sellerId        String
  buyerId         String
  totalAmount     Decimal       @db.Decimal(16, 2)
  platformFeePct  Decimal       @db.Decimal(5, 2)  @default(1.5)
  platformFee     Decimal       @db.Decimal(14, 2)
  netSellerAmount Decimal       @db.Decimal(14, 2)
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  contractUrl     String?
  deliveryAddress String?
  notes           String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  offer              Offer               @relation(fields: [offerId], references: [id])
  seller             User                @relation("SellerOrders", fields: [sellerId], references: [id])
  buyer              User                @relation("BuyerOrders", fields: [buyerId], references: [id])
  payments           Payment[]
  transportRequest   TransportRequest?
  testingRequests    TestingRequest[]
  statusHistory      OrderStatusHistory[]
  ratings            Rating[]
  // NOTE: transactions are linked via plain referenceId string — no FK here
  // because Transaction.referenceId is polymorphic (orders, bookings, etc.)

  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String
  amount          Decimal  @db.Decimal(14, 2)
  currency        String   @default("PKR")
  method          String   // easypaisa | jazzcash | bank_transfer | stripe | cash
  status          String   @default("pending")
  gatewayRef      String?
  gatewayResponse Json?
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

// ─── WAREHOUSE ────────────────────────────────────────────────────────────────

model WarehouseProfile {
  id                  String        @id @default(uuid())
  // No longer @unique — NEW_Changes item 10: an operator account can run
  // more than one warehouse (e.g. facilities in different cities). Kept
  // indexed since "all warehouses for this operator" is now a common
  // lookup (see WarehouseService.getMyWarehouses).
  userId              String
  name                String
  type                WarehouseType
  city                String
  province            String
  address             String
  gpsCoordinates      String?
  totalCapacityTons   Float
  pricePerTonMonth    Decimal       @db.Decimal(10, 2)
  // Per-commodity overrides of pricePerTonMonth — e.g. paddy stores
  // differently (and often cheaper) than milled/parboiled rice, so a
  // single flat rate for the whole warehouse wasn't realistic. Shape:
  // { "Basmati Paddy": "180.00", "Parboiled Rice": "220.00" }. A commodity
  // this warehouse accepts but has no entry for here just falls back to
  // pricePerTonMonth (see resolveRatePerTonMonth() in warehouse.service.ts).
  ratesByCommodity    Json?
  // Rate for the booking-time "include insurance" option (per ton per
  // month, same unit as pricePerTonMonth). Null/unset means the operator
  // hasn't priced insurance yet, so bookStorage() refuses
  // includeInsurance requests rather than silently charging nothing for
  // it — this is intentionally separate from StorageInsurance, which is a
  // different, post-receipt third-party policy an owner buys later.
  insurancePricePerTonMonth Decimal? @db.Decimal(10, 2)
  minDurationDays     Int
  commoditiesAccepted String[]
  certifications      String[]
  features            String[]
  bankPartners        String[]
  insuranceAvailable  Boolean       @default(false)
  isActive            Boolean       @default(true)
  isVerified          Boolean       @default(false)
  managerName         String?
  managerPhone        String?
  establishedYear     Int?
  description         String?
  rating              Float         @default(0)
  reviewCount         Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relation back to User (profile owner)
  user                User          @relation(fields: [userId], references: [id])

  // All bookings and receipts at this warehouse
  bookings            StorageBooking[]
  receipts            WarehouseReceipt[]
  invoices            WarehouseInvoice[]
  goodsReceiptNotes   GoodsReceiptNote[]
  gateOutPasses       GateOutPass[]

  @@index([province])
  @@index([type])
  @@index([userId])
  @@map("warehouse_profiles")
}

model StorageBooking {
  id               String        @id @default(uuid())
  // Human-readable, unique, immutable booking reference (e.g.
  // "WHB-2026-000001"), derived from bookingSeq the same way a User's
  // AgriConnect ID is derived from agriConnectSeq — see
  // src/common/utils/booking-reference.util.ts. A native Postgres
  // autoincrement sequence guarantees atomic, collision-free uniqueness
  // under concurrent bookings with no extra locking.
  bookingSeq       Int           @unique @default(autoincrement())
  warehouseId      String   // FK → WarehouseProfile.id
  depositorId      String   // FK → User.id (the person storing goods)
  commodity        String
  variety          String?
  quantityTons     Float
  packagingType    String?
  entryDate        DateTime
  durationDays     Int
  exitDate         DateTime
  pricePerTon      Decimal  @db.Decimal(10, 2)
  // Itemized so both sides can see what they paid for insurance
  // specifically, instead of it being invisibly folded into totalCost —
  // see WarehouseProfile.insurancePricePerTonMonth.
  insuranceCost    Decimal? @db.Decimal(12, 2)
  totalCost        Decimal  @db.Decimal(14, 2)
  status           BookingStatus @default(REQUESTED)
  // Set when the warehouse operator rejects a REQUESTED booking.
  rejectionReason  String?
  // Set when the depositor or operator cancels a REQUESTED/ACCEPTED booking.
  cancelReason     String?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  cancelledAt      DateTime?
  completedAt      DateTime?
  includeInsurance Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  warehouse        WarehouseProfile @relation(fields: [warehouseId], references: [id])
  depositor        User             @relation(fields: [depositorId], references: [id])
  receipt          WarehouseReceipt?
  invoice          WarehouseInvoice?
  goodsReceiptNote GoodsReceiptNote?
  gateOutPasses    GateOutPass[]
  messages         BookingMessage[]

  @@index([warehouseId])
  @@index([depositorId])
  @@index([status])
  @@map("storage_bookings")
}

// Conversation thread attached to a single storage booking, so the
// depositor and the warehouse operator can talk without leaving the
// platform. INFO_REQUEST is a message the operator sends specifically to
// ask the depositor for more details before deciding on a booking.
// Admins/moderators can read a thread but not post to it.
enum BookingMessageKind {
  MESSAGE
  INFO_REQUEST
}

model BookingMessage {
  id        String             @id @default(uuid())
  bookingId String
  senderId  String
  kind      BookingMessageKind @default(MESSAGE)
  body      String
  createdAt DateTime           @default(now())

  booking   StorageBooking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender    User               @relation(fields: [senderId], references: [id])

  @@index([bookingId, createdAt])
  @@map("booking_messages")
}

model WarehouseReceipt {
  id             String        @id @default(uuid())
  receiptNumber  String        @unique
  bookingId      String        @unique  // FK → StorageBooking.id
  warehouseId    String        // FK → WarehouseProfile.id
  ownerId        String        // FK → User.id
  commodity      String
  variety        String?
  quantityTons   Float
  qualityMetrics Json?
  entryDate      DateTime
  expiryDate     DateTime
  marketValue    Decimal       @db.Decimal(16, 2)
  status         ReceiptStatus @default(ACTIVE)
  pdfUrl         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  booking        StorageBooking   @relation(fields: [bookingId], references: [id])
  warehouse      WarehouseProfile @relation(fields: [warehouseId], references: [id])
  owner          User             @relation(fields: [ownerId], references: [id])
  lien           BankLien?
  insurance      StorageInsurance?

  @@index([ownerId])
  @@index([status])
  @@map("warehouse_receipts")
}

model BankLien {
  id           String     @id @default(uuid())
  receiptId    String     @unique
  bankName     String
  loanPurpose  String
  loanAmount   Decimal    @db.Decimal(16, 2)
  interestRate Decimal    @db.Decimal(5, 2)
  tenureMonths Int
  loanOfficer  String?
  loanRefNo    String?
  status       LienStatus @default(ACTIVE)
  placedAt     DateTime   @default(now())
  releasedAt   DateTime?
  releaseNote  String?
  updatedAt    DateTime   @updatedAt

  receipt      WarehouseReceipt @relation(fields: [receiptId], references: [id])

  @@map("bank_liens")
}

model StorageInsurance {
  id             String   @id @default(uuid())
  receiptId      String   @unique
  provider       String
  planName       String
  policyNumber   String
  coverageAmount Decimal  @db.Decimal(16, 2)
  premiumAmount  Decimal  @db.Decimal(12, 2)
  coverage       String
  startDate      DateTime
  endDate        DateTime
  status         String   @default("active")
  policyDocUrl   String?
  createdAt      DateTime @default(now())

  receipt        WarehouseReceipt @relation(fields: [receiptId], references: [id])

  @@map("storage_insurance")
}

// NEW_Changes item 10 — storage invoice for a booking. One per booking
// (bookingId is unique): storage rate structure already gives one clean
// total per booking, so there's no reason to support multiple invoices
// against the same booking. amounts are copied from the booking at
// generation time rather than re-read live, so the invoice stays accurate
// even if the operator edits their rates afterward.
model WarehouseInvoice {
  id               String        @id @default(uuid())
  invoiceNumber    String        @unique
  // Race-safe uniqueness the same way StorageBooking.bookingSeq works —
  // see booking-reference.util.ts's comment for why a native Postgres
  // autoincrement beats a COUNT-based scheme under concurrency.
  invoiceSeq       Int           @unique @default(autoincrement())
  bookingId        String        @unique
  warehouseId      String
  depositorId      String
  storageCost      Decimal       @db.Decimal(14, 2)
  insuranceCost    Decimal?      @db.Decimal(12, 2)
  totalAmount      Decimal       @db.Decimal(14, 2)
  status           InvoiceStatus @default(UNPAID)
  // Manual payment confirmation (no payment gateway integrated — see
  // InvoiceStatus comment) — a free-text reference the operator/admin
  // enters when marking this paid (bank transfer ref, cheque no., etc.).
  paymentReference String?
  paidAt           DateTime?
  confirmedById    String?       // operator or admin who confirmed payment
  s3Key            String        // generated PDF, in the same bucket as other uploads
  issuedAt         DateTime      @default(now())
  createdAt        DateTime      @default(now())

  booking          StorageBooking   @relation(fields: [bookingId], references: [id])
  warehouse        WarehouseProfile @relation(fields: [warehouseId], references: [id])
  depositor        User             @relation(fields: [depositorId], references: [id])

  @@index([warehouseId])
  @@index([depositorId])
  @@map("warehouse_invoices")
}

// Issued once the physical goods actually arrive at the warehouse — a
// separate, formal "goods received" acknowledgment distinct from the
// WarehouseReceipt (which is a collateral/ownership document used for bank
// liens and insurance, and may be issued at a different moment in the
// operator's workflow).
model GoodsReceiptNote {
  id           String   @id @default(uuid())
  grnNumber    String   @unique
  grnSeq       Int      @unique @default(autoincrement())
  bookingId    String   @unique
  warehouseId  String
  depositorId  String
  commodity    String
  variety      String?
  quantityTons Float
  qualityNotes String?
  receivedAt   DateTime @default(now())
  receivedById String   // operator user id who confirmed physical receipt
  s3Key        String
  createdAt    DateTime @default(now())

  booking      StorageBooking   @relation(fields: [bookingId], references: [id])
  warehouse    WarehouseProfile @relation(fields: [warehouseId], references: [id])
  depositor    User             @relation(fields: [depositorId], references: [id])

  @@index([warehouseId])
  @@map("goods_receipt_notes")
}

// Authorizes goods to physically leave the warehouse. A booking can have
// more than one (a rejected/re-requested pass shouldn't block a fresh
// attempt), so this isn't unique on bookingId the way Invoice/GRN are.
model GateOutPass {
  id            String         @id @default(uuid())
  // Only set once APPROVED — a PENDING/REJECTED request was never
  // actually issued, so it doesn't get a pass number.
  passNumber    String?        @unique
  passSeq       Int            @unique @default(autoincrement())
  bookingId     String
  warehouseId   String
  depositorId   String
  quantityTons  Float
  requestedById String         // warehouse operator who prepared the request
  requestNote   String?
  status        GatePassStatus @default(PENDING)
  approvedById  String?
  // 'DEPOSITOR' | 'ADMIN' — see GatePassStatus comment on the schema enum
  // above for why both can authorize release.
  approverRole  String?
  approvedAt    DateTime?
  rejectionNote String?
  s3Key         String?        // only present once APPROVED and the pass PDF is generated
  createdAt     DateTime       @default(now())

  booking       StorageBooking   @relation(fields: [bookingId], references: [id])
  warehouse     WarehouseProfile @relation(fields: [warehouseId], references: [id])
  depositor     User             @relation(fields: [depositorId], references: [id])

  @@index([bookingId])
  @@index([warehouseId])
  @@index([status])
  @@map("gate_out_passes")
}

// ─── TESTING ──────────────────────────────────────────────────────────────────
// agencyId → TestingAgencyProfile.userId (NOT User.id directly)

model TestingAgencyProfile {
  id              String   @id @default(uuid())
  userId          String   @unique  // FK → User.id
  name            String
  city            String
  province        String
  accreditations  String[]
  services        String[]
  basePrice       Decimal  @db.Decimal(10, 2)
  turnaroundHours Int
  coverageAreas   String[]
  isActive        Boolean  @default(true)
  isVerified      Boolean  @default(false)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  // All testing requests assigned to this agency
  requests        TestingRequest[]

  @@map("testing_agency_profiles")
}

model TestingRequest {
  id                 String        @id @default(uuid())
  requesterId        String        // FK → User.id (who requested the test)
  agencyId           String        // FK → TestingAgencyProfile.userId
  productId          String?
  orderId            String?
  servicesRequested  String[]
  scheduledDate      DateTime?
  fee                Decimal       @db.Decimal(10, 2)
  paymentStatus      PaymentStatus @default(UNPAID)
  status             TestingStatus @default(REQUESTED)
  sampleLocation     String?
  reportUrl          String?
  reportData         Json?
  completedAt        DateTime?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // FIX 1: requester is a plain User; agency is a TestingAgencyProfile
  requester          User                 @relation("TestingRequester", fields: [requesterId], references: [id])
  agency             TestingAgencyProfile @relation(fields: [agencyId], references: [userId])
  order              Order?               @relation(fields: [orderId], references: [id])

  @@index([requesterId])
  @@index([agencyId])
  @@index([status])
  @@map("testing_requests")
}

// ─── TRANSPORT ────────────────────────────────────────────────────────────────
// providerId → TransportProfile.userId (NOT User.id directly)

model TransportProfile {
  id                String       @id @default(uuid())
  userId            String       @unique  // FK → User.id
  companyName       String
  vehicleTypes      VehicleType[]
  maxCapacityTons   Float
  coverageProvinces String[]
  pricePerKm        Decimal      @db.Decimal(8, 2)
  hasGps            Boolean      @default(false)
  hasInsurance      Boolean      @default(false)
  licenseNumber     String?
  isActive          Boolean      @default(true)
  isVerified        Boolean      @default(false)
  rating            Float        @default(0)
  reviewCount       Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user              User             @relation(fields: [userId], references: [id])
  // All transport requests assigned to this provider
  requests          TransportRequest[]

  @@map("transport_profiles")
}

model TransportRequest {
  id               String          @id @default(uuid())
  requesterId      String          // FK → User.id (who requested transport)
  providerId       String?         // FK → TransportProfile.userId
  orderId          String?         @unique
  pickupLocation   String
  pickupCity       String
  pickupGps        String?
  deliveryLocation String
  deliveryCity     String
  deliveryGps      String?
  cargoDescription String?
  cargoWeightTons  Float?
  vehicleType      VehicleType?
  requiredDate     DateTime?
  quotedPrice      Decimal?        @db.Decimal(12, 2)
  agreedPrice      Decimal?        @db.Decimal(12, 2)
  status           TransportStatus @default(REQUESTED)
  trackingUrl      String?
  currentLocation  String?
  estimatedArrival DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  driverName       String?
  driverPhone      String?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // FIX 2: requester is a plain User; provider is a TransportProfile
  requester        User             @relation("TransportRequester", fields: [requesterId], references: [id])
  provider         TransportProfile? @relation(fields: [providerId], references: [userId])
  order            Order?           @relation(fields: [orderId], references: [id])

  @@index([requesterId])
  @@index([providerId])
  @@index([status])
  @@map("transport_requests")
}

// ─── MESSAGING ────────────────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(uuid())
  participants  String[]  // array of User.id strings (no FK — flexible grouping)
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  messages      Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  receiverId     String
  content        String
  fileUrl        String?
  fileType       String?
  isRead         Boolean  @default(false)
  readAt         DateTime?
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender",   fields: [senderId],   references: [id])
  receiver       User         @relation("MessageReceiver", fields: [receiverId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

// ─── RATINGS ──────────────────────────────────────────────────────────────────

model Rating {
  id         String   @id @default(uuid())
  reviewerId String
  reviewedId String
  orderId    String?
  productId  String?
  rating     Int      // 1–5
  category   String   // product_quality | delivery | communication | reliability
  comment    String?
  createdAt  DateTime @default(now())

  reviewer   User     @relation("RatingReviewer", fields: [reviewerId], references: [id])
  reviewed   User     @relation("RatingReviewed", fields: [reviewedId], references: [id])
  order      Order?   @relation(fields: [orderId],   references: [id])
  product    Product? @relation(fields: [productId], references: [id])

  @@index([reviewedId])
  @@map("ratings")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ─── TRANSACTIONS ─────────────────────────────────────────────────────────────
// referenceId is intentionally polymorphic (can point to orderId, bookingId,
// testingRequestId, transportRequestId, etc.).
// We do NOT add a formal Prisma FK here because Prisma does not support
// polymorphic relations. Query by referenceId + referenceType in application code.

model Transaction {
  id            String          @id @default(uuid())
  userId        String
  type          TransactionType
  amount        Decimal         @db.Decimal(14, 2)
  currency      String          @default("PKR")
  description   String
  referenceId   String?         // polymorphic — orderId | bookingId | requestId | …
  referenceType String?         // "order" | "storage" | "testing" | "transport"
  balanceBefore Decimal?        @db.Decimal(14, 2)
  balanceAfter  Decimal?        @db.Decimal(14, 2)
  createdAt     DateTime        @default(now())

  user          User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([referenceId])
  @@map("transactions")
}

// ─── LISTING MEDIA (Warehouse / Testing Agency / Transport) ───────────────────
// Product already has its own ProductMedia model. Warehouses, testing
// agencies, and transporters didn't have anywhere to attach photos or
// documents — this covers all three with one polymorphic-by-convention
// table (entityType + entityId strings, same pattern already used by
// Transaction.referenceId above) rather than three near-identical models.
model ListingMedia {
  id         String   @id @default(uuid())
  entityType String   // "warehouse" | "testing_agency" | "transport"
  entityId   String   // WarehouseProfile.id | TestingAgencyProfile.id | TransportProfile.id
  type       String   // "image" | "document"
  url        String
  s3Key      String?
  label      String?
  isPrimary  Boolean  @default(false) // the display picture shown on the listing card
  sortOrder  Int      @default(0)
  uploadedBy String?  // User.id of whoever uploaded it
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("listing_media")
}

// ─── AUDIT LOG ──────────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  // who performed the action (null for system-initiated)
  action     String   // "login" | "password_change" | "kyc_approved" | "kyc_rejected" |
                        // "product_removed" | "user_deactivated" | "user_created_by_admin" | …
  entityType String?  // "user" | "product" | "order" | "warehouse" | …
  entityId   String?
  details    Json?    // free-form context (e.g. { reason: "..." })
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
